<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>PSTextMate</AssemblyName>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Version>0.3.0</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>14.0</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <AnalysisLevel>latest-Recommended</AnalysisLevel>
    </PropertyGroup>
  <ItemGroup>
    <None Update="LICENSE.Fullscreen.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="LICENSE.Unicode.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="themes/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="grammars/**/*" Exclude="grammars/TOML.tmLanguage;grammars/KDL.tmLanguage.json;grammars/LICENSE.*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="grammars/LICENSE.KDL.txt" TargetPath="LICENSE.KDL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="grammars/KDL.tmLanguage.json" LogicalName="PSTextMate.KDL.tmLanguage.json" />
    <None Update="grammars/LICENSE.TOML.txt" TargetPath="LICENSE.TOML.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="grammars/TOML.tmLanguage" LogicalName="PSTextMate.TOML.tmLanguage" />
    <PackageReference Include="Tint" Version="0.3.0" />
    <PackageReference Include="Tint.Grammars" Version="0.3.0" />
    <PackageReference Include="Tint.Themes" Version="0.3.0" />
    <PackageReference Include="System.Management.Automation" Version="7.6.9" PrivateAssets="all" />
    <ProjectReference Include="../PSTextMate.ALC/PSTextMate.ALC.csproj" />
    <InternalsVisibleTo Include="PSTextMate.Spectre" />
    <InternalsVisibleTo Include="PSTextMate.XenoAtom" />
    <InternalsVisibleTo Include="PSTextMate.Markdown" />
    <InternalsVisibleTo Include="PSTextMate.Images" />
    <InternalsVisibleTo Include="PSTextMate.InteractiveTests" />
    <InternalsVisibleTo Include="PSTextMate.CoreTests" />
  </ItemGroup>
</Project>
