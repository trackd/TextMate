<Configuration>
  <ViewDefinitions>
    <View>
      <Name>TextMateContent</Name>
      <ViewSelectedBy>
        <TypeName>PSTextMate.Core.TextContent</TypeName>
      </ViewSelectedBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding>
                <ScriptBlock>
                  $availableWidth = 80
                  try { $availableWidth = [Math]::Max(1, $Host.UI.RawUI.WindowSize.Width) } catch { }
                  [PSTextMate.Core.OutputRenderer]::Format($_, $availableWidth)
                </ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
    <View>
      <Name>NativeHighlightedOutput</Name>
      <ViewSelectedBy>
        <TypeName>PSTextMate.NativeOutput</TypeName>
        <TypeName>PSTextMate.Spectre.TextMateRenderable</TypeName>
        <TypeName>PSTextMate.XenoAtom.TextMateVisual</TypeName>
      </ViewSelectedBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding>
                <ScriptBlock>
                  $availableWidth = 80
                  try { $availableWidth = [Math]::Max(1, $Host.UI.RawUI.WindowSize.Width) } catch { }
                  [PSTextMate.Core.OutputRenderer]::Format($_, $availableWidth)
                </ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
    <View>
      <Name>TextMateGrammar</Name>
      <ViewSelectedBy>
        <TypeName>PSTextMate.Core.Language</TypeName>
        </ViewSelectedBy>
        <TableControl>
          <TableHeaders>
            <TableColumnHeader>
              <Label>Id</Label>
              <Width>20</Width>
            </TableColumnHeader>
            <TableColumnHeader>
              <Label>Extensions</Label>
              <Width>45</Width>
            </TableColumnHeader>
            <TableColumnHeader>
              <Label>Aliases</Label>
              <Width>45</Width>
            </TableColumnHeader>
          </TableHeaders>
          <TableRowEntries>
            <TableRowEntry>
              <TableColumnItems>
                <TableColumnItem>
                  <PropertyName>Id</PropertyName>
                </TableColumnItem>
                <TableColumnItem>
                  <ScriptBlock>
                    $_.Extensions -join ', '
                  </ScriptBlock>
                </TableColumnItem>
                <TableColumnItem>
                  <ScriptBlock>
                    $_.Aliases -join ', '
                  </ScriptBlock>
                </TableColumnItem>
              </TableColumnItems>
            </TableRowEntry>
          </TableRowEntries>
        </TableControl>
    </View>
    <View>
      <Name>HighlightedDocument</Name>
      <ViewSelectedBy>
        <TypeName>PSTextMate.Core.HighlightedDocument</TypeName>
      </ViewSelectedBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding>
                <ScriptBlock>
                  $availableWidth = 80
                  try { $availableWidth = [Math]::Max(1, $Host.UI.RawUI.WindowSize.Width) } catch { }
                  [PSTextMate.Core.OutputRenderer]::Format($_, $availableWidth)
                </ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>

  </ViewDefinitions>
</Configuration>
